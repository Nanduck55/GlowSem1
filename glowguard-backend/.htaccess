# Apache (XAMPP) often strips the "Authorization: Bearer <token>" header before
# PHP sees it, which makes every logged-in request fail with
# "Missing Authorization header." These rules pass it through to PHP.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
